# Aither Stack Technologies - Environment Variables Example
# Copy this file to .env and fill in your values

# Cal.com booking link
VITE_CALCOM_LINK=https://cal.com/your-username/your-event-type

# Google Apps Script Web App URL for contact form submissions
# This is a public endpoint URL (not a secret)
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Optional: reCAPTCHA Enterprise site key (public, safe to expose)
# VITE_RECAPTCHA_SITE_KEY=your_site_key_here

# Optional: Analytics
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX